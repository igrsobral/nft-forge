# Os mocks ficam ativos, exceto quando o valor é exatamente "false". O build de demonstração os mantém ativos.
VITE_ENABLE_MOCKS=true

# Cenário padrão quando não há valor salvo nem ?scenario= na URL.
# success | empty | latency | offline | http_error | expired_session | unauthorized
# signup_conflict | invalid_coupon | expired_coupon | price_changed | sold_out
# order_timeout | payment_confirmed | payment_declined
VITE_MOCK_SCENARIO=success

# OpenTelemetry (traces no navegador). Desativado até configurar o endpoint do coletor.
# Receptor OTLP/HTTP; por padrão, use a mesma origem para evitar CORS. Ex.: http://localhost:4318/v1/traces
VITE_OTEL_ENABLED=true
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_OTEL_SERVICE_NAME=nft-marketplace
VITE_OTEL_SAMPLE_RATIO=1
VITE_OTEL_ENVIRONMENT=development
